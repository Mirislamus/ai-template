# Публичный адрес сайта: canonical, sitemap, Open Graph (без слэша на конце)
PUBLIC_SITE_URL="https://domain.ru"

# Базовый URL API. Для собственного серверного эндпоинта форм — "/api"
# (в Next.js публичные переменные называются NEXT_PUBLIC_*)
PUBLIC_API_URL="/api"

# Идентификаторы счетчиков аналитики (ADR 0015)
PUBLIC_YM_ID="12345678"
PUBLIC_GA_ID=""

# В Astro все переменные дополнительно объявляются в env.schema файла astro.config.ts (docs/setup/frontend.md §3.1)

# Серверные секреты интеграции форм (без префикса PUBLIC_: в клиентский бандл не попадают).
# Набор определяется допросом по продукту (PROMPT.md, ветка «Интеграции»).
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Серверный адрес API для SSR фронтенда, только в проекте с бэкендом (ADR 0020 §1)
API_INTERNAL_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Бэкенд (apps/api), только если бэкенд выбран (ADR 0019 §1).
# В монорепо раздел переносится в apps/api/.env.example (docs/setup/common.md §4).
# Значения ниже — для локальной разработки (база из apps/api/compose.dev.yml).
NODE_ENV="development"
PORT="3000"
DATABASE_URL="postgres://app:app@localhost:5432/app"
# Случайная строка не короче 32 байт: openssl rand -base64 32 (ADR 0023 §4)
BETTER_AUTH_SECRET=""
# Публичный адрес сайта, на котором работает /api/auth
BETTER_AUTH_URL="http://localhost:4321"
UPLOADS_DIR="./uploads"
LOG_LEVEL="debug"
# Служебный Telegram-чат для алертов (ADR 0023 §6)
ALERT_TELEGRAM_BOT_TOKEN=""
ALERT_TELEGRAM_CHAT_ID=""

# Только продакшен (/srv/project/.env рядом с docker-compose.yml, docs/setup/backend.md §7)
POSTGRES_DB=""
POSTGRES_USER=""
POSTGRES_PASSWORD=""
APP_DB_USER=""
APP_DB_PASSWORD=""
API_TAG=""
